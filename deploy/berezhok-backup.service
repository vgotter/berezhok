[Unit]
Description=Berezhok database and photo backup
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/root/berezhok/server
EnvironmentFile=/root/berezhok/server/.env
Environment=BACKUP_DIR=/root/backups/berezhok
Environment=BACKUP_KEEP_DAYS=30
ExecStart=/root/berezhok/server/venv/bin/python /root/berezhok/server/backup.py
